{
  "mcpServers": {
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--headless", "--isolated"]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y chrome-devtools-mcp@1.12.0 --headless --isolated --usageStatistics=false --no-performance-crux ${CHROME_DEVTOOLS_MCP_EXECUTABLE_PATH:+--executablePath=\"$CHROME_DEVTOOLS_MCP_EXECUTABLE_PATH\" --chromeArg=--no-sandbox}"
      ]
    }
  }
}
